# ==========================================
# Miras Heritage Foods - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Replace with your MongoDB Atlas connection string from cloud.mongodb.com:
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/miras_heritage?retryWrites=true&w=majority


# Security & Session Secrets
JWT_SECRET="miras-heritage-jwt-secret-key-2026-production"

# ==========================================
# Payment Gateways (Placeholders)
# ==========================================
# When left blank or in test mode, the system automatically runs in Mock Sandbox Mode.
# Once you receive live or test keys, simply paste them below:

# 1. Razorpay Credentials
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"

# 2. Cashfree Credentials
CASHFREE_APP_ID="cf_test_placeholder_app_id"
CASHFREE_SECRET_KEY="cf_test_placeholder_secret_key"
CASHFREE_ENV="TEST" # "TEST" or "PROD"
